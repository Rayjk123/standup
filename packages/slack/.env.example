# Standup Slack adapter — streaming probe config.
# Copy to `packages/slack/.env` (gitignored) and fill in. Bun auto-loads it.
#
# See README.md for how to create the app, enable Socket Mode, add scopes, and
# where to copy each token from.

# Bot token — OAuth & Permissions page, "Bot User OAuth Token". Starts with xoxb-.
# Required for every check.
SLACK_BOT_TOKEN=xoxb-...

# App-level token — Basic Information → App-Level Tokens, scope connections:write.
# Starts with xapp-. Only needed to test the Socket Mode websocket handshake (check B).
SLACK_APP_TOKEN=xapp-...

# A scratch channel to post test messages into. Use the channel ID (C…/D…/G…),
# NOT the #name. Invite the bot first: `/invite @your-bot`. Needed for checks C/D.
SLACK_PROBE_CHANNEL=C0XXXXXXX

# Optional — a parent message ts to stream inside a thread. Leave unset to stream
# at channel root. Some AI/assistant streaming setups prefer a thread.
# SLACK_PROBE_THREAD_TS=

# ---- running adapter (bun run slack:start) ----------------------------------

# OPTIONAL. Who gets DM'd for asks AND is authorized to launch/steer sessions
# from Slack (the operator-configured owner). The adapter learns an ask DELIVERY
# recipient from whoever DMs the bot, but that learned recipient carries NO
# authority — launching or steering a repo-modifying agent on this host requires
# this explicit owner (or a SLACK_STEER_ALLOWLIST entry below). Set it to your own
# Slack member ID to launch/steer from Slack (Slack profile → ⋮ → Copy member ID).
# It is also the host for Persona-in-Slack — the user whose own Persona Slack
# always reaches; without it (or a SLACK_OWNER_MAP entry for the host's alias)
# Persona-in-Slack stays off. Other users reach their own Persona only when
# listed in SLACK_PERSONA_USERS below.
# SLACK_ASK_USER=U0XXXXXXX

# OPTIONAL. Extra Slack user ids (comma/space-separated) authorized to launch a
# session or steer a live agent from Slack, beyond SLACK_ASK_USER. Leave unset in
# a single-user setup. Nobody is authorized by merely DMing the bot — authority
# comes only from this list or SLACK_ASK_USER.
# SLACK_STEER_ALLOWLIST=U0AAAAAAA,U0BBBBBBB

# Optional. The feed channel is normally set live from Slack ("@standup-dev feed
# here") and persisted as the collector setting `slackFeedChannel`; this only
# seeds it when that setting is empty.
# SLACK_FEED_CHANNEL=C0XXXXXXX

# OPTIONAL owner→Slack-id map — `alias:U…` pairs, comma/space-separated. Setting
# it OPTS IN to owner-routed attention: an ask/alert for a session routes to that
# session's OWNER (DM / @-mention their Slack id) instead of the learned
# recipient, and an owner-less session's ask is suppressed rather than posted
# channel-wide. Leave unset to keep owner routing OFF (delivery falls back to the
# learned recipient, as before). A `slack:U…` owner actor needs no entry — its id
# is used directly.
# SLACK_OWNER_MAP=alice:U0AAAAAAA,bob:U0BBBBBBB

# OPTIONAL. Aliases (comma/space-separated) that get their own Persona in Slack
# besides the host. Each also needs a SLACK_OWNER_MAP entry naming their Slack
# id; they DM the app (or @-mention it) to talk to their own Persona, and DM
# `login` for a console sign-in link. A mapped alias NOT listed here keeps only
# owner-routed asks, as before. Leave unset for host-only Persona-in-Slack.
# SLACK_PERSONA_USERS=bob

# OPTIONAL. The mail domain whose addresses are <alias>@<domain>, with the same
# alias the console's identity header carries. A Slack user whose email is at
# exactly this domain has their Slack actor merged into that alias's actor, so
# one teammate isn't counted twice. Unset (the default), the adapter uses the
# org profile's identity.emailDomain (STANDUP_ORG_PROFILE, else
# ~/.config/standup/org-profile.json); with no domain there either it merges
# no one, since a guest at another domain could otherwise be folded into an
# alias that shares their email's local-part. Set it to a value that is not a
# domain (none) to merge no one even when the org profile names a domain.
# SLACK_IDENTITY_EMAIL_DOMAIN=example.com

# The console origin teammates' browsers reach (for example through an
# authenticating proxy or tunnel). Login links (`login` DMs)
# and the console links in Slack messages point here. Falls back to
# STANDUP_CONSOLE_ORIGIN (what scripts/console-login.ts reads); with neither,
# console links use http://localhost:5173 and `login` DMs get no link — set this
# whenever SLACK_PERSONA_USERS is set.
# STANDUP_WEB_URL=https://standup.example.dev

# Optional collector location (defaults shown). WS URL is derived from these.
# COLLECTOR_URL=http://127.0.0.1:7777
# SLACK_WS_URL=ws://127.0.0.1:7778
